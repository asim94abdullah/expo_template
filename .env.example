# Copy this file to `.env` and fill in local values:
#   cp .env.example .env
#
# Variables prefixed with EXPO_PUBLIC_ are inlined into the client bundle.
# Never put private keys, signing secrets, or database credentials in EXPO_PUBLIC_ variables.
# See: https://docs.expo.dev/guides/environment-variables/

# App
EXPO_PUBLIC_APP_ENV=development

# API
EXPO_PUBLIC_API_BASE_URL=https://api.example.com
EXPO_PUBLIC_API_TIMEOUT_MS=15000
EXPO_PUBLIC_USE_MOCK_API=true

# Public client keys (visible in the compiled app)
EXPO_PUBLIC_API_KEY=

# Private / local-only secrets (not inlined into JavaScript)
# API_SECRET_KEY=
